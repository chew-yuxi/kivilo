{
  "name": "kivilo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "marketing:build": "node scripts/prepare-marketing.mjs && next build marketing --webpack",
    "marketing:dev": "node scripts/prepare-marketing.mjs && next dev marketing --port 3115",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup:storage": "tsx scripts/setup-storage.ts",
    "billing:setup": "tsx scripts/setup-billing.ts",
    "provider:upsert": "tsx scripts/upsert-service-provider.ts",
    "team:set": "tsx scripts/set-team.ts",
    "plan:set": "tsx scripts/set-plan.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0",
    "sharp": "0.35.3",
    "standardwebhooks": "^1.0.0",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "ffmpeg-static",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
