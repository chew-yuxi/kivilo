generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// The spine. Kept deliberately thin here so M1 (the deal wizard) extends these
// rather than migrating away from them.
// ---------------------------------------------------------------------------

enum StakeholderKind {
  INDIVIDUAL
  ENTITY
}

model Stakeholder {
  id        String          @id @default(cuid())
  kind      StakeholderKind @default(INDIVIDUAL)
  name      String
  idNumber  String?
  /// Stored lowercase. Unique because sign-in links a login to the one row holding its
  /// verified address, so a second row for the same person is a deal they never see.
  email     String?         @unique
  phone     String?
  /// Supabase auth user id, set when someone signs in and claims this stakeholder.
  /// Most stakeholders (landlords, tenants) never sign in and leave this null; it is
  /// what separates "a person on a deal" from "a person with a login".
  authUserId String?        @unique
  /// Billing workspace membership. Property access is granted separately per tenancy.
  teamId    String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  team                Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  agencyMemberships AgencyMembership[]

  tenanciesAsLandlord Tenancy[] @relation("LandlordTenancies")
  tenanciesAsTenant   Tenancy[] @relation("TenantTenancies")
  tenanciesAsAgent    Tenancy[] @relation("AgentTenancies")
  tenancyCollaborations TenancyCollaborator[] @relation("TenancyCollaborator")
  tenancyAccessGranted TenancyCollaborator[] @relation("TenancyAccessGrantor")
  inspectionsRun      Inspection[] @relation("InspectionConductor")
  reportInspections Inspection[] @relation("InspectionReportAgent")
  inspectionAccessGrants InspectionAccessGrant[]
  signatures          Signature[]
  deletionRequests    AccountDeletionRequest[]
  maintenanceCasesReported MaintenanceCase[] @relation("MaintenanceReporter")
  maintenanceEvents MaintenanceEvent[]
  maintenanceVerifications MaintenanceVerification[]
  maintenanceEvidenceUploaded MaintenanceEvidence[]
  responsibilityProposed  ResponsibilityProposal[] @relation("ResponsibilityProposer")
  responsibilityResponded ResponsibilityProposal[] @relation("ResponsibilityResponder")
  notifications Notification[]
  deviceInstallations DeviceInstallation[]
  branding AgentBranding?
  errorEvents ErrorEvent[]
  productEvents ProductEvent[]
  acquisition AccountAcquisition?
  reportEmails ReportEmail[]
  addendaCreated   ReportAddendum[] @relation("AddendumCreator")
  addendaPublished ReportAddendum[] @relation("AddendumPublisher")
  addendaDisputed  ReportAddendum[] @relation("AddendumDisputer")
  addendumAcknowledgements AddendumAcknowledgement[]
  findingPhotoDrafts FindingPhotoDraft[]
  assessmentResponses AssessmentResponse[]
  supportingDocumentRequests SupportingDocumentRequest[]
  supportingDocumentFiles SupportingDocumentFile[]
  /// The plan of an agent who is on no team. An agent on a team uses the team's.
  subscription         Subscription?  @relation("OwnSubscription")
  subscriptionsManaged Subscription[] @relation("ManagedSubscriptions")

  @@index([name])
  @@index([teamId])
}

/// One verified account's first observed acquisition and conversion milestones.
/// Created only when a verified Auth user first claims/creates its stakeholder;
/// existing linked accounts are never assigned a guessed signup date or source.
model AccountAcquisition {
  stakeholderId String @id
  verifiedAt DateTime
  recordedAt DateTime @default(now())
  /// Finite, validated client observations; absent attribution is "unattributed".
  source String
  medium String?
  campaign String?
  landing String?
  entryPoint String
  excluded Boolean @default(false)
  /// Stamped by the countersignature transaction, never client analytics.
  firstCompletedReportAt DateTime?
  /// A successful positive live Stripe invoice; not a trial, comp or entitlement.
  firstPaidAt DateTime?
  firstPaidInvoiceId String? @unique
  firstPaidAmount Int?
  firstPaidCurrency String?
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([verifiedAt])
}

/// A billing workspace set up with `pnpm team:set`. Membership does not grant or revoke
/// property access; the lead agent shares each tenancy explicitly.
model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      Stakeholder[]
  subscription Subscription?
}

enum AgencyRole {
  OWNER
  MANAGER
  AGENT
}

enum AgencyMembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// Operational membership is separate from the existing billing-only Team.
model Agency {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members AgencyMembership[]
  tenancies Tenancy[]
  activity AgencyActivity[]
  branding AgencyBranding?
  reportInspections Inspection[] @relation("InspectionReportAgency")
}

/// The shared identity on reports prepared in this operational team's workspace.
/// The responsible agent's own CEA registration and phone remain on AgentBranding.
model AgencyBranding {
  agencyId String @id
  agencyLicence String?
  phone String?
  /// Private bucket path, at `agency-branding/<agencyId>/logo`.
  logoPath String?
  updatedAt DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model AgencyMembership {
  id String @id @default(cuid())
  agencyId String
  stakeholderId String
  role AgencyRole @default(AGENT)
  status AgencyMembershipStatus @default(INVITED)
  invitedById String?
  expiresAt DateTime?
  acceptedAt DateTime?
  removedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  notifications Notification[]
  @@unique([agencyId, stakeholderId])
  @@index([stakeholderId, status])
}

/// Append-only history; names are retained when an account is removed.
model AgencyActivity {
  id String @id @default(cuid())
  agencyId String
  actorId String
  actorName String
  subjectId String?
  subjectName String?
  action String
  createdAt DateTime @default(now())
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  @@index([agencyId, createdAt])
}

enum Plan {
  PRO
}

/// A workspace's paid or comped plan. A workspace is a team, or an agent on no team, so
/// exactly one of teamId and stakeholderId is set (a CHECK constraint holds it). Free is
/// the absence of a row. What a plan allows is decided in `src/lib/plan.ts` and nowhere
/// else; this row only records what was bought.
model Subscription {
  id            String  @id @default(cuid())
  teamId        String? @unique
  stakeholderId String? @unique
  plan          Plan
  seats         Int
  /// Stripe's subscription status verbatim (active, trialing, past_due, canceled, ...),
  /// or "comped" for a plan set by `pnpm plan:set` with nothing in Stripe behind it.
  status               String
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// The member who manages billing. Null once they delete their account, and then any
  /// member of the workspace may.
  managedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation("OwnSubscription", fields: [stakeholderId], references: [id], onDelete: Cascade)
  managedBy   Stakeholder? @relation("ManagedSubscriptions", fields: [managedById], references: [id], onDelete: SetNull)
}

/// The complete report identity for an agent's personal work. For team work, the
/// responsible agent's CEA registration and contact are combined with AgencyBranding.
/// With none set, a personal report reads as Kivilo's. Branding is presentation rather
/// than signed report content, so the pinned agent and team use their current details.
model AgentBranding {
  stakeholderId   String   @id
  agencyName      String
  agencyLicence   String?
  ceaRegistration String?
  phone           String?
  /// Private bucket path, at `branding/<stakeholderId>/logo`.
  logoPath        String?
  updatedAt       DateTime @updatedAt

  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
}

enum PropertyType {
  HDB
  PRIVATE_NON_LANDED
  LANDED
  COMMERCIAL
}

/// The durable hub. Outlives every relationship on it.
model Property {
  id         String       @id @default(cuid())
  line1      String
  unit       String?
  postalCode String
  type       PropertyType
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  archivedAt DateTime?
  trashedAt DateTime?
  trashExpiresAt DateTime?
  trashedById String?

  tenancies Tenancy[]
  assets PropertyAsset[]
  events PropertyEvent[]
  bin BinItem[]

  @@index([postalCode])
}

/// One append-only line of a property's history: who changed or deleted what, and when.
/// Written in the same transaction as the change (`src/lib/property-history.ts`), never
/// edited afterwards except to fold a burst of the same person's edits into one line.
model PropertyEvent {
  id           String   @id @default(cuid())
  propertyId   String
  tenancyId    String?
  inspectionId String?
  actorId      String?
  actorName    String
  kind         String
  summary      String
  /// Field changes as `{ changes: [{ field, from, to }] }`, or a count for a burst.
  detail       Json?
  /// The thing a burst folds into, e.g. `item:<id>`. Null for events that never fold.
  subjectKey   String?
  binItemId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  binItem  BinItem? @relation(fields: [binItemId], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([subjectKey, actorId, updatedAt])
}

/// Something deleted from a working report, kept for 30 days so it can be restored.
/// `rows` is the removed rows exactly as they were (`src/lib/bin.ts`); nothing reads
/// them except Restore, so no report, fingerprint or PDF query needs to know the bin exists.
model BinItem {
  id           String    @id @default(cuid())
  propertyId   String
  tenancyId    String
  inspectionId String
  kind         String
  label        String
  rows         Json
  deletedById  String?
  deletedAt    DateTime  @default(now())
  expiresAt    DateTime
  restoredAt   DateTime?
  restoredById String?

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events   PropertyEvent[]

  @@index([expiresAt])
  @@index([inspectionId])
}

model Tenancy {
  id         String   @id @default(cuid())
  propertyId String
  landlordId String
  tenantId   String
  agentId    String?
  agencyId String?
  startDate  DateTime
  endDate    DateTime
  monthlyRent Decimal @db.Decimal(10, 2)
  deposit     Decimal @db.Decimal(10, 2)
  /// Tenant pays up to this per repair, landlord the rest. Only prefills a cost
  /// proposal; the tenant still accepts or rejects every one.
  minorRepairCap     Decimal? @db.Decimal(10, 2)
  /// Human-confirmed clause and source agreement. The cap remains a proposal default.
  minorRepairClause Json?
  /// Whether the agent may accept or reject a tenant's cost proposal for the landlord.
  /// Only the landlord can change it.
  agentMayAgreeCosts Boolean  @default(true)
  /// First N Singapore calendar days from the tenancy start, inclusive. Zero disables
  /// move-in notices. Fixed once the tenant signs the check-in.
  defectWindowDays Int @default(30)
  /// Reminder choices belong to the tenancy, so collaborators see the same decision.
  renewalDecision RenewalDecision?
  renewalSnoozedUntil DateTime?
  /// A renewal is a new term on the same property, never an edit to the signed term.
  renewedFromId String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord Stakeholder  @relation("LandlordTenancies", fields: [landlordId], references: [id])
  tenant   Stakeholder  @relation("TenantTenancies", fields: [tenantId], references: [id])
  agent    Stakeholder? @relation("AgentTenancies", fields: [agentId], references: [id])
  agency Agency? @relation(fields: [agencyId], references: [id])

  inspections Inspection[]
  collaborators TenancyCollaborator[]
  notifications Notification[]
  maintenanceCases MaintenanceCase[]
  supportingDocumentRequests SupportingDocumentRequest[]
  renewedFrom Tenancy? @relation("TenancyRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedAs Tenancy? @relation("TenancyRenewal")

  @@index([propertyId])
  @@index([agencyId])
}

/// Full working access to one tenancy. Inspection conductors remain attribution only;
/// removing this grant revokes access even when the person conducted an inspection.
model TenancyCollaborator {
  id            String   @id @default(cuid())
  tenancyId     String
  stakeholderId String
  /// Null for historical access preserved by the migration, or a deleted grantor.
  grantedById   String?
  createdAt     DateTime @default(now())

  tenancy     Tenancy     @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation("TenancyCollaborator", fields: [stakeholderId], references: [id], onDelete: Cascade)
  grantedBy   Stakeholder? @relation("TenancyAccessGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([tenancyId, stakeholderId])
  @@index([stakeholderId])
}

enum RenewalDecision {
  NOT_RENEWING
  DISMISSED
}

// ---------------------------------------------------------------------------
// M4: check-in / check-out
// ---------------------------------------------------------------------------

enum InspectionKind {
  CHECK_IN
  CHECK_OUT
}

enum InspectionStatus {
  DRAFT
  CAPTURING
  PROCESSING
  REVIEW
  AWAITING_SIGNATURE
  COMPLETED
  FAILED
}

enum FurnishingLevel {
  FULLY_FURNISHED
  PARTIALLY_FURNISHED
  UNFURNISHED
}

model Inspection {
  id            String           @id @default(cuid())
  tenancyId     String
  kind          InspectionKind
  status        InspectionStatus @default(DRAFT)
  /// Compatibility copy for app builds released before furnishing became three-way.
  fullyFurnished Boolean          @default(true)
  /// Determines which editable starter rows a newly added room receives.
  furnishingLevel FurnishingLevel @default(FULLY_FURNISHED)
  conductedById String?
  /// Responsible agent frozen at Send. Handover changes Tenancy.agentId only.
  reportAgentId String?
  /// Operational team frozen at Send. Later assignment cannot rewrite the report header.
  reportAgencyId String?
  reportAgentFrozen Boolean @default(false)
  conductedAt   DateTime?
  /// A check-out points at the check-in it is measured against.
  baselineId    String?          @unique
  summary       String?
  processingError String?
  /// Unguessable bearer token for the read-only report link handed to the landlord
  /// and tenant. Null until someone shares the report. Revoked by setting it back to
  /// null, which is why it is nullable rather than generated with the row.
  shareToken    String?          @unique
  sharedAt      DateTime?
  /// Consent by the inspector before home media is sent to external AI providers.
  aiConsentAt   DateTime?
  aiConsentById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenancy     Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  conductedBy Stakeholder? @relation("InspectionConductor", fields: [conductedById], references: [id])
  reportAgent Stakeholder? @relation("InspectionReportAgent", fields: [reportAgentId], references: [id])
  reportAgency Agency? @relation("InspectionReportAgency", fields: [reportAgencyId], references: [id])
  baseline    Inspection?  @relation("Baseline", fields: [baselineId], references: [id])
  checkOut    Inspection?  @relation("Baseline")

  rooms      Room[]
  findings   Finding[]
  findingPhotoDrafts FindingPhotoDraft[]
  signatures Signature[]
  assessments AssessmentVersion[]
  issuedReportFiles IssuedReportFile[]
  reportEmails ReportEmail[]
  addenda     ReportAddendum[]
  accessGrants InspectionAccessGrant[]
  moveInDefectCases MaintenanceCase[] @relation("MoveInDefectInspection")

  @@index([tenancyId, kind])
  @@index([reportAgencyId])
}

/// Exact inspection access preserved from the old conductor rule. This never grants
/// access to sibling inspections or the tenancy's repairs, and is explicitly revocable.
model InspectionAccessGrant {
  id            String   @id @default(cuid())
  inspectionId  String
  stakeholderId String
  createdAt     DateTime @default(now())

  inspection  Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, stakeholderId])
  @@index([stakeholderId])
}

enum CaptureKind {
  /// Narrated walkthrough of one room.
  VIDEO
  /// Deliberate still: a label, a serial plate, a meter face, a specific defect.
  /// Video is downsampled too far to read small print; this is what OCR runs on.
  PHOTO
}

/// The evidence. AI is the scribe; this is the witness.
/// Captures belong to a room, not to the inspection, so an inspector can re-shoot
/// one room without disturbing rooms already reviewed.
model Capture {
  id          String      @id @default(cuid())
  /// Stable native-client id. A lost registration response must not create another row.
  clientId    String?     @unique
  roomId      String
  kind        CaptureKind @default(VIDEO)
  storagePath String      @unique
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  /// What the inspector said while recording, or typed against a photo.
  transcript  String?
  /// Inspector's own note attached at capture time, before any model sees it.
  note        String?
  /// Rings and arrows the inspector drew over this photo, with the intrinsic size of
  /// the upright image they were drawn against. Data over an unmodified original: the
  /// object at storagePath is never rewritten. Shape and parser live in
  /// src/lib/annotations.ts. Human-authored by construction, so it carries its own
  /// author and time and never a confidence.
  annotations Json?
  processedAt DateTime?
  /// A still from a video, stored next to it, so a list can show what a video is without
  /// loading any of it. Made by the poster cron (src/lib/poster.ts); null until then.
  posterPath     String?  @unique
  /// Failed poster runs. The cron stops after a few, so one unreadable file cannot
  /// occupy every run.
  posterAttempts Int      @default(0)
  createdAt   DateTime    @default(now())

  room  Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  items InspectionItem[]
  itemEvidence ItemEvidence[]

  @@index([roomId])
}

enum RoomStatus {
  /// Created by the inspector, nothing captured yet.
  PENDING
  CAPTURING
  PROCESSING
  /// Draft items exist, awaiting a human pass.
  REVIEW
  REVIEWED
  FAILED
}

model Room {
  id              String     @id @default(cuid())
  inspectionId    String
  name            String
  order           Int
  status          RoomStatus @default(PENDING)
  processingError String?
  processingAttemptId String?
  processingStartedAt DateTime?
  /// On a check-out room, the room as the check-out began from it, frozen when it
  /// started (`RoomBaseline` in `src/lib/check-in-reference.ts`): its lines and the photos
  /// agreed of it, the check-in's and any acknowledged addendum's. Null on check-ins, on
  /// rooms added during a check-out, and on check-outs started before it existed.
  baseline        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  inspection Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  captures   Capture[]
  items      InspectionItem[]

  @@index([inspectionId])
}

enum ItemCategory {
  FIXTURE
  APPLIANCE
  FURNITURE
  SURFACE
  METER
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

model InspectionItem {
  id       String        @id @default(cuid())
  roomId   String
  name     String
  category ItemCategory
  condition ItemCondition
  quantity Int           @default(1)
  notes    String?
  /// Make, model, and serial read verbatim off a photographed label or plate.
  /// This is what makes an inventory line identify one specific object rather than
  /// a category of object. That difference is what decides a deposit dispute.
  identifier String?
  /// Meter reading, verbatim as spoken or read. Free text, because units vary.
  meterReading String?
  /// The capture this item was read from, so the report can show its evidence.
  sourceCaptureId String?
  /// Where in that capture the item is clearest. Video captures only.
  sourceTimestampSec Int?
  /// Model self-reported confidence, 0–1. Null once a human has taken ownership.
  confidence   Float?
  editedByHuman Boolean @default(false)
  /// A durable property asset selected by a human. Identifier similarity may be
  /// suggested in UI, but model output never links assets automatically.
  propertyAssetId String?
  /// On a check-out row, the key of the check-in line it was copied from (`item:<id>` or
  /// `entry:<id>`, as `currentState` names lines), so the inspector can see what it was
  /// at check-in after editing it. Null on check-ins and on rows added during check-out.
  baselineKey  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sourceCapture Capture? @relation(fields: [sourceCaptureId], references: [id], onDelete: SetNull)
  propertyAsset PropertyAsset? @relation(fields: [propertyAssetId], references: [id], onDelete: SetNull)
  evidence      ItemEvidence[]

  findingsAsSubject  Finding[] @relation("FindingItem")
  findingsAsBaseline Finding[] @relation("FindingBaselineItem")

  @@index([roomId])
  @@index([propertyAssetId])
}

/// A human-curated link from an inventory line to one or more original room captures.
/// Notes and photo marks remain on Capture, so the same evidence is never copied or
/// rewritten when it is attached to several items.
model ItemEvidence {
  itemId    String
  captureId String
  createdAt DateTime @default(now())

  item    InspectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  capture Capture        @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@id([itemId, captureId])
  @@index([captureId])
}

// ---------------------------------------------------------------------------
// M5: longitudinal property maintenance
// ---------------------------------------------------------------------------

enum PropertyAssetCategory {
  APPLIANCE
  FIXTURE
  FURNITURE
  SURFACE
  SYSTEM
  OTHER
}

model PropertyAsset {
  id         String                @id @default(cuid())
  propertyId String
  name       String
  category   PropertyAssetCategory
  roomLabel  String?
  identifier String?
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inspectionItems InspectionItem[]
  maintenanceCases MaintenanceCase[]
  addendumEntries ReportAddendumEntry[]

  @@index([propertyId, active])
  @@index([propertyId, identifier])
}

enum MaintenanceCategory {
  APPLIANCE
  PLUMBING
  LOCKSMITH
  ELECTRICAL
  AIR_CONDITIONING
  STRUCTURAL
  PEST
  OTHER
}

enum MaintenancePriority {
  ROUTINE
  URGENT
  SAFETY_EMERGENCY
}

enum MaintenanceStatus {
  REPORTED
  ACKNOWLEDGED
  SCHEDULED
  AWAITING_CONFIRMATION
  RESOLVED
  CLOSED_NO_ACTION
}

model MaintenanceCase {
  id               String              @id @default(cuid())
  clientId         String?             @unique
  tenancyId        String
  propertyAssetId  String?
  reportedById     String
  category         MaintenanceCategory
  priority         MaintenancePriority @default(ROUTINE)
  title            String
  description      String
  status           MaintenanceStatus   @default(REPORTED)
  resolutionReason String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  /// A timely tenant report reserves its move-in notice while evidence uploads finish.
  wasPresentAtMoveIn Boolean @default(false)
  /// Pin the signed check-in when the intent is recorded; later reports cannot retarget it.
  moveInDefectInspectionId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenancy       Tenancy        @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  propertyAsset PropertyAsset? @relation(fields: [propertyAssetId], references: [id], onDelete: SetNull)
  reportedBy    Stakeholder    @relation("MaintenanceReporter", fields: [reportedById], references: [id])
  events        MaintenanceEvent[]
  visits        MaintenanceVisit[]
  evidence      MaintenanceEvidence[]
  findings      Finding[]
  responsibilityProposals ResponsibilityProposal[]
  addendumEntries ReportAddendumEntry[]
  moveInDefectInspection Inspection? @relation("MoveInDefectInspection", fields: [moveInDefectInspectionId], references: [id], onDelete: SetNull)
  moveInDefectAddendum ReportAddendum? @relation("MoveInDefectSource")

  @@index([tenancyId, status, createdAt])
  @@index([propertyAssetId, createdAt])
}

enum MaintenanceEventKind {
  REPORTED
  COMMENT
  STATUS_CHANGED
  VISIT_RECORDED
  VERIFICATION
  REOPENED
  RESPONSIBILITY_PROPOSED
  RESPONSIBILITY_ACCEPTED
  RESPONSIBILITY_REJECTED
  RESPONSIBILITY_WITHDRAWN
}

model MaintenanceEvent {
  id        String               @id @default(cuid())
  caseId    String
  actorId   String?
  kind      MaintenanceEventKind
  body      String?
  metadata  Json?
  createdAt DateTime             @default(now())

  maintenanceCase MaintenanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor           Stakeholder?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

model MaintenanceVisit {
  id          String    @id @default(cuid())
  caseId      String
  providerId  String?
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  cost        Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  maintenanceCase MaintenanceCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider        ServiceProvider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  evidence        MaintenanceEvidence[]
  verification    MaintenanceVerification?

  @@index([caseId, completedAt])
}

enum MaintenanceEvidencePurpose {
  BEFORE
  AFTER
  RECEIPT
}

model MaintenanceEvidence {
  id          String                     @id @default(cuid())
  clientId    String                     @unique
  caseId      String
  visitId     String?
  uploadedById String
  purpose     MaintenanceEvidencePurpose
  storagePath String                     @unique
  mimeType    String
  sizeBytes   Int
  note        String?
  createdAt   DateTime                   @default(now())

  maintenanceCase MaintenanceCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  visit           MaintenanceVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  uploadedBy      Stakeholder       @relation(fields: [uploadedById], references: [id])

  @@index([caseId, createdAt])
  @@index([visitId])
}

enum MaintenanceVerificationOutcome {
  FIXED
  NOT_FIXED
}

model MaintenanceVerification {
  id           String                         @id @default(cuid())
  visitId      String                         @unique
  verifiedById String
  outcome      MaintenanceVerificationOutcome
  note         String?
  createdAt    DateTime                       @default(now())

  visit      MaintenanceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  verifiedBy Stakeholder      @relation(fields: [verifiedById], references: [id])
}

enum RepairParty {
  LANDLORD
  TENANT
}

enum CostPayer {
  LANDLORD
  TENANT
  SHARED
}

enum ResponsibilityBasis {
  MINOR_REPAIR_CLAUSE
  TENANT_CAUSED
  FAIR_WEAR
  LANDLORD_OBLIGATION
  OTHER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

/// Who arranges a repair and who pays for it, as one side proposes and the other
/// answers. Append-only: changing an agreement is a new proposal, never an edit.
/// At most one PENDING and one ACCEPTED per case, enforced by partial unique indexes
/// in the migration because Prisma cannot express them.
model ResponsibilityProposal {
  id            String              @id @default(cuid())
  caseId        String
  proposedById  String
  arrangedBy    RepairParty
  payer         CostPayer
  /// Required when payer is SHARED: the tenant pays up to this, the landlord the rest.
  tenantCap     Decimal?            @db.Decimal(10, 2)
  basis         ResponsibilityBasis
  reason        String
  /// Free text such as "Clause 5(c)" until tenancy agreements are extracted.
  clauseRef     String?
  status        ProposalStatus      @default(PENDING)
  respondedById String?
  respondedAt   DateTime?
  responseNote  String?
  createdAt     DateTime            @default(now())

  maintenanceCase MaintenanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  proposedBy      Stakeholder     @relation("ResponsibilityProposer", fields: [proposedById], references: [id])
  respondedBy     Stakeholder?    @relation("ResponsibilityResponder", fields: [respondedById], references: [id])

  @@index([caseId, createdAt])
}

enum ServiceProviderCategory {
  PLUMBING
  LOCKSMITH
}

model ServiceProvider {
  id             String                  @id @default(cuid())
  name           String
  category       ServiceProviderCategory
  phone          String
  whatsapp       String?
  serviceAreas   String[]
  hours          String?
  lastVerifiedAt DateTime
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  visits MaintenanceVisit[]

  @@index([category, active])
  @@unique([category, phone])
}

enum NotificationKind {
  SUPPORTING_DOCUMENT_REQUESTED
  SUPPORTING_DOCUMENT_UPLOADED
  AGENCY_INVITATION
  PROPERTY_SHARED
  MAINTENANCE_REPORTED
  MAINTENANCE_STATUS
  MAINTENANCE_VISIT
  MAINTENANCE_VERIFICATION
  MAINTENANCE_RESPONSIBILITY
  REPEAT_REPAIR
  /// An addendum to a signed report was published and waits for this party.
  REPORT_UPDATED
  RENEWAL_DUE
}

/// Optional private tenancy paperwork, separate from the signed condition report.
enum SupportingDocumentKind {
  SUPPORTING
  TENANCY_AGREEMENT
}

model SupportingDocumentRequest {
  id String @id @default(cuid())
  tenancyId String
  clientId String
  title String
  kind SupportingDocumentKind @default(SUPPORTING)
  requestedById String
  requestedAt DateTime @default(now())

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  requestedBy Stakeholder @relation(fields: [requestedById], references: [id])
  files SupportingDocumentFile[]

  @@unique([tenancyId, clientId])
  @@index([requestedById])
}

/// Created before issuing an upload URL. Pending rows preserve immutable upload
/// ownership and the cleanup path; only verified storage bytes set submittedAt.
model SupportingDocumentFile {
  id String @id @default(cuid())
  requestId String
  clientId String @unique
  storagePath String @unique
  fileName String
  mimeType String
  byteSize Int
  submittedById String
  createdAt DateTime @default(now())
  submittedAt DateTime?

  request SupportingDocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy Stakeholder @relation(fields: [submittedById], references: [id])

  @@index([requestId, submittedAt])
  @@index([submittedById])
}

enum DevicePlatform {
  ANDROID
  IOS
}

model DeviceInstallation {
  id            String         @id @default(cuid())
  stakeholderId String
  token         String         @unique
  platform      DevicePlatform
  lastSeenAt    DateTime       @default(now())
  disabledAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stakeholder Stakeholder                @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  deliveries  NotificationPushDelivery[]

  @@index([stakeholderId, disabledAt, lastSeenAt])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  tenancyId   String?
  agencyMembershipId String?
  kind        NotificationKind
  title       String
  body        String
  href        String?
  dedupeKey   String?          @unique
  readAt      DateTime?
  emailTo     String?
  emailAttempts Int            @default(0)
  emailSentAt DateTime?
  emailError  String?
  pushExpandedAt DateTime?
  createdAt   DateTime         @default(now())

  recipient Stakeholder @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  tenancy Tenancy? @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  agencyMembership AgencyMembership? @relation(fields: [agencyMembershipId], references: [id], onDelete: Cascade)
  pushDeliveries NotificationPushDelivery[]

  @@index([recipientId, readAt, createdAt])
  @@index([tenancyId, recipientId])
  @@index([emailSentAt, emailAttempts, createdAt])
  @@index([pushExpandedAt, createdAt])
}

model NotificationPushDelivery {
  id             String   @id @default(cuid())
  notificationId String
  installationId String
  attempts       Int      @default(0)
  claimedAt      DateTime?
  sentAt         DateTime?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notification Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  installation DeviceInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, installationId])
  @@index([sentAt, attempts, createdAt])
}

enum ChangeType {
  UNCHANGED
  WEAR
  DAMAGE
  MISSING
  IMPROVED
}

enum Verdict {
  TENANT_LIABLE
  FAIR_WEAR
  DISPUTED
  UNDECIDED
}

/// Check-out only. The dispute moment, drafted by the model and owned by a human.
model Finding {
  id             String     @id @default(cuid())
  inspectionId   String
  /// A client save id makes retrying a lost create response exactly once.
  clientId       String? @unique
  itemId         String?
  baselineItemId String?
  /// Human-selected maintenance history to preserve with a published assessment.
  maintenanceCaseId String?
  changeType     ChangeType
  verdict        Verdict    @default(UNDECIDED)
  rationale      String
  estimatedCost  Decimal?   @db.Decimal(10, 2)
  confidence     Float?
  editedByHuman  Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  inspection   Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item         InspectionItem? @relation("FindingItem", fields: [itemId], references: [id], onDelete: SetNull)
  baselineItem InspectionItem? @relation("FindingBaselineItem", fields: [baselineItemId], references: [id], onDelete: SetNull)
  maintenanceCase MaintenanceCase? @relation(fields: [maintenanceCaseId], references: [id], onDelete: SetNull)
  photos FindingPhoto[]
  photoDrafts FindingPhotoDraft[]

  @@index([inspectionId])
  @@index([maintenanceCaseId])
}

/// Personal working photos before Save. This is not a visible finding. A discarded
/// draft remains a tombstone so delayed queue requests cannot recreate its uploads.
model FindingPhotoDraft {
  id String @id
  inspectionId String
  createdById String
  findingId String?
  savedAt DateTime?
  discardedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  createdBy Stakeholder @relation(fields: [createdById], references: [id])
  finding Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  photos FindingPhoto[]

  @@index([inspectionId, findingId, savedAt, discardedAt])
  @@index([createdById])
}

/// Intent first, bytes second, registration last. Stored photographs never change;
/// annotations stay beside them and are copied by value into each assessment version.
model FindingPhoto {
  clientId String @id
  draftId String
  findingId String?
  storagePath String @unique
  mimeType String
  sizeBytes Int?
  note String?
  annotations Json?
  registeredAt DateTime?
  deletedAt DateTime?
  /// Once any assessment includes these bytes, deleting working rows never purges them.
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft FindingPhotoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  finding Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([findingId, deletedAt, createdAt])
  @@index([draftId, deletedAt])
}

model Signature {
  id            String   @id @default(cuid())
  inspectionId  String
  stakeholderId String
  signedAt      DateTime @default(now())
  ipAddress     String?
  /// data: URL of the drawn signature.
  imageData     String
  /// sha256 of the report content this person signed (`src/lib/report-fingerprint.ts`).
  /// Null on signatures taken before it existed.
  contentHash   String?

  inspection  Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id])

  @@unique([inspectionId, stakeholderId])
}

enum ReportEmailKind {
  /// "Please review and sign", with a link to /sign/[inspectionId].
  SIGNATURE_REQUEST
  /// "Both parties have signed", with the signed PDF attached.
  SIGNED_COPY
  /// Tenant's handover instructions and move-in defect deadline, after their signature.
  TENANT_HANDOVER
}

/// Outbox for report emails (`src/lib/report-email.ts`). A row is written in the same
/// transaction as the change that calls for it (Send, or the second signature) and
/// `/api/internal/report-emails` delivers it, so a Resend outage delays an email
/// instead of failing a signature.
model ReportEmail {
  id           String          @id @default(cuid())
  inspectionId String
  recipientId  String
  kind         ReportEmailKind
  /// Makes the signed copy once only per recipient. Null for signature requests, which
  /// the agent may resend.
  dedupeKey    String?         @unique
  /// The address it went to, read from the recipient at delivery.
  emailTo      String?
  attempts     Int             @default(0)
  /// Not before this. Pushed back exponentially after each failure.
  retryAt      DateTime        @default(now())
  sentAt       DateTime?
  error        String?
  createdAt    DateTime        @default(now())

  inspection Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  recipient  Stakeholder @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([sentAt, attempts, retryAt])
  @@index([inspectionId, recipientId])
}

/// A human-published, immutable assessment. The signed inventory has its own lifecycle.
model AssessmentVersion {
  id            String     @id @default(cuid())
  inspectionId  String
  version       Int
  snapshot      Json
  contentHash   String
  publishedAt   DateTime   @default(now())
  publishedById String

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  responses  AssessmentResponse[]

  @@unique([inspectionId, version])
  @@index([inspectionId, publishedAt])
}

/// A dated update to a COMPLETED check-in, after it was signed: an appliance replaced, a
/// fixture removed. Never an edit to the signed rows; see plans/report-addenda.md.
/// A draft has no number and is the agent's working copy, entries and photos included.
/// Publishing numbers it, writes `snapshot` and `contentHash`, and freezes it. It counts
/// (check-out baseline, timeline) only from `acknowledgedAt`, when both the landlord and
/// the tenant have acknowledged it.
model ReportAddendum {
  id             String    @id @default(cuid())
  inspectionId   String
  number         Int?
  title          String
  reason         String?
  /// The day the change happened, which is what the "Updated" banner shows.
  effectiveDate  DateTime
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  publishedById  String?
  /// Everything the report draws, by value. Shape in src/lib/addenda.ts.
  snapshot       Json?
  contentHash    String?
  acknowledgedAt DateTime?
  /// A tenant's dated move-in notice, published directly from their maintenance report.
  sourceMaintenanceCaseId String? @unique
  disputedAt DateTime?
  disputedById String?
  disputeReason String?

  inspection       Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  createdBy        Stakeholder               @relation("AddendumCreator", fields: [createdById], references: [id])
  publishedBy      Stakeholder?              @relation("AddendumPublisher", fields: [publishedById], references: [id])
  entries          ReportAddendumEntry[]
  acknowledgements AddendumAcknowledgement[]
  sourceMaintenanceCase MaintenanceCase? @relation("MoveInDefectSource", fields: [sourceMaintenanceCaseId], references: [id], onDelete: SetNull)
  disputedBy Stakeholder? @relation("AddendumDisputer", fields: [disputedById], references: [id])

  @@unique([inspectionId, number])
  @@index([inspectionId, createdAt])
}

enum AddendumChange {
  ADDED
  REPLACED
  REMOVED
}

/// One line of an addendum while it is drafted. Rendering reads the snapshot, never this.
model ReportAddendumEntry {
  id         String         @id @default(cuid())
  addendumId String
  change     AddendumChange
  roomName   String
  /// The line a REPLACED or REMOVED entry changes: `item:<InspectionItem id>` for a signed
  /// check-in item, `entry:<entry id>` for a line an earlier addendum added.
  targetKey  String?
  /// The new line, for ADDED and REPLACED.
  name       String?
  category   ItemCategory?
  condition  ItemCondition?
  quantity   Int            @default(1)
  identifier String?
  notes      String?
  /// The resolved repair this entry was started from.
  maintenanceCaseId String?
  /// The asset publishing created for this line, so a check-out copies the link.
  propertyAssetId   String?
  /// Upload intents survive a missing photo registration, so deleting the entry
  /// can remove objects written by an outstanding signed upload URL.
  uploadPaths       String[] @default([])
  createdAt  DateTime       @default(now())

  addendum        ReportAddendum        @relation(fields: [addendumId], references: [id], onDelete: Cascade)
  maintenanceCase MaintenanceCase?      @relation(fields: [maintenanceCaseId], references: [id], onDelete: SetNull)
  propertyAsset   PropertyAsset?        @relation(fields: [propertyAssetId], references: [id], onDelete: SetNull)
  photos          ReportAddendumPhoto[]

  @@index([addendumId, createdAt])
}

/// A photo for an entry: uploaded under `addenda/<addendumId>/`, or the same object as a
/// maintenance case's evidence, referenced rather than copied.
model ReportAddendumPhoto {
  id          String   @id @default(cuid())
  entryId     String
  storagePath String
  mimeType    String
  sizeBytes   Int?
  note        String?
  /// "Before" or "After" for a repair's evidence.
  label       String?
  /// Provenance only, so the same evidence is not attached twice.
  maintenanceEvidenceId String?
  createdAt   DateTime @default(now())

  entry ReportAddendumEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

enum AcknowledgementMethod {
  OWN_ACCOUNT
  IN_PERSON
}

/// A landlord or tenant saying "I acknowledge this update", against the exact content
/// they were shown: signed in as themselves, or in person on the agent's phone.
model AddendumAcknowledgement {
  id             String   @id @default(cuid())
  addendumId     String
  stakeholderId  String
  acknowledgedAt DateTime @default(now())
  ipAddress      String?
  contentHash    String
  /// How it was given: on the party's own account, or in person on the agent's phone.
  /// Null on acknowledgements from before the in-person path, which were all their own.
  method         AcknowledgementMethod?

  addendum    ReportAddendum @relation(fields: [addendumId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder    @relation(fields: [stakeholderId], references: [id])

  @@unique([addendumId, stakeholderId])
}

enum DeletionRequestStatus {
  REQUESTED
  PROCESSING
  COMPLETED
}

/// In-app requests are fulfilled by an operator under the approved retention policy.
model AccountDeletionRequest {
  id            String                @id @default(cuid())
  stakeholderId String                @unique
  status        DeletionRequestStatus @default(REQUESTED)
  requestedAt   DateTime              @default(now())
  dueAt         DateTime
  completedAt   DateTime?
  notificationSentAt DateTime?
  processingPolicyVersion String?
  fulfilledUnderPolicy String?
  email         String?

  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id])
  storagePurges AccountDeletionStoragePurge[]

  @@index([status, dueAt])
  @@index([stakeholderId, requestedAt])
}

/// A durable prefix manifest for media belonging to an erased draft room. Signed
/// upload URLs can remain valid for two hours after the room row is deleted; cleanup
/// only completes after that window and a verified empty Storage listing.
model AccountDeletionStoragePurge {
  id          String    @id @default(cuid())
  requestId   String
  roomId      String    @unique
  readyAt     DateTime
  completedAt DateTime?

  request AccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, completedAt])
}

/// Tombstone for a capture or room removed from the working report. The DB row may
/// disappear before a still-valid signed upload URL expires, so Storage removal is
/// delayed and retried independently of the request that deleted the row.
model StoragePurge {
  id          String    @id @default(cuid())
  path        String    @unique
  isPrefix    Boolean
  readyAt     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([completedAt, readyAt])
}

enum ErrorSource {
  SERVER
  WEB
  ANDROID
  IOS
}

/// One error, as it happened, from the server, an agent's browser, or the app. Grouped on read by
/// `fingerprint`, a hash of where it came from and what it said with ids and numbers
/// normalized out, so the same bug on two inspections is one problem rather than two.
/// `notifiedAt` is stamped by the alert cron, which emails a fingerprint only the first
/// time it is seen. Kept for 90 days, as the privacy policy says.
model ErrorEvent {
  /// A browser report carries its own UUID, so a retried batch cannot record twice.
  id            String      @id @default(uuid())
  source        ErrorSource
  /// Where it was caught: render, action, route or api on the server; boundary, window
  /// or rejection in the browser; flutter, platform or caught in the app.
  context       String
  name          String
  message       String
  stack         String?
  /// React's digest for a server error. The browser shows it as the error's reference,
  /// so it is how an agent's screenshot is matched to the stack.
  digest        String?
  path          String?
  release       String?
  userAgent     String?
  fingerprint   String
  stakeholderId String?
  occurredAt    DateTime
  createdAt     DateTime    @default(now())
  notifiedAt    DateTime?

  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
  @@index([notifiedAt])
  @@index([createdAt])
  @@index([stakeholderId])
}

enum ProductEventSource {
  WEB
  ANDROID
  IOS
}

/// Allowlisted usage events, with identity stamped by the authenticated server.
/// No addresses, report tokens, free text or IPs. Kept for 90 days.
model ProductEvent {
  id            String             @id @default(uuid())
  source        ProductEventSource
  name          String
  properties    Json
  release       String?
  stakeholderId String
  occurredAt    DateTime
  createdAt     DateTime           @default(now())

  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([stakeholderId, createdAt])
}

/// Every report PDF Kivilo has handed out, by the SHA-256 of its exact bytes, so anyone
/// holding a copy can check it is one we issued and has not been altered since
/// (`src/lib/report-verification.ts`). Rows outlive the stored file, which is replaced
/// whenever the report changes and deleted when its link is revoked: a genuine copy
/// stays genuine.
model IssuedReportFile {
  sha256       String   @id
  inspectionId String
  storagePath  String
  issuedAt     DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId, issuedAt])
  @@index([storagePath])
}

/// The landlord's or tenant's answer to the deposit statement in one published
/// assessment version: agreed, or disputed with a reason. One per party per version and
/// never edited; a revised assessment is a new version with its own answers, and the old
/// ones stay against the old hash (`src/lib/statement-actions.ts`).
model AssessmentResponse {
  id                  String                @id @default(cuid())
  assessmentVersionId String
  stakeholderId       String
  answer              StatementAnswer
  /// Required to dispute.
  reason              String?
  method              AcknowledgementMethod
  /// The version's `contentHash`, which covers the frozen deposit and every finding.
  contentHash         String
  ipAddress           String?
  respondedAt         DateTime              @default(now())

  assessmentVersion AssessmentVersion @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  stakeholder       Stakeholder       @relation(fields: [stakeholderId], references: [id])

  @@unique([assessmentVersionId, stakeholderId])
  @@index([stakeholderId])
}

enum StatementAnswer {
  AGREED
  DISPUTED
}
